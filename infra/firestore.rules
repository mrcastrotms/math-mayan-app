rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Question bank protection: server-side evaluation only
    match /question_bank/{questionId} {
      allow read, write: if false;
    }
    // Roster PII protection: direct client reads/writes disallowed
    match /class_rosters/{sectionId} {
      allow read, write: if false;
    }

    // All application access is performed through server routes using the Admin
    // SDK. Anonymous Firebase clients are not trusted.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}