rules_version = "2";
service cloud.firestore {
  match /databases/{database}/documents {
    // Roster data contains PII - strictly serverless Admin SDK access only
    match /class_rosters/{sectionId} {
      allow read, write: if false;
    }

    // All application access is performed through server routes using the Admin
    // SDK. Anonymous Firebase clients are not trusted.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
